# ===================================
# Peblo TV Mini — Environment Variables
# ===================================

# Database
DATABASE_URL=postgresql+asyncpg://peblo:peblo_secret@localhost:5432/peblo_tv
DATABASE_URL_SYNC=postgresql://peblo:peblo_secret@localhost:5432/peblo_tv

# Auth
JWT_SECRET=change-me-in-production-use-256-bit-random-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Storage
STORAGE_BACKEND=local   # "local" or "r2"
STORAGE_LOCAL_PATH=./storage
STORAGE_SERVE_URL=http://localhost:8000/static/storage

# R2 (only needed if STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=peblo-tv-assets
R2_PUBLIC_URL=https://assets.peblo.tv

# Seeding
SEED_ON_STARTUP=true

# Frontend URLs (for CORS and Vite proxy)
VITE_API_URL=http://localhost:8000

# ---
# PRODUCTION SECRETS MANAGEMENT:
# In production, DO NOT commit this file.
# Use one of:
# - AWS Secrets Manager or Parameter Store
# - HashiCorp Vault
# - Doppler
# - Kubernetes sealed secrets / external-secrets-operator
#
# In CI (GitHub Actions), inject via:
# - Repository secrets → env vars in workflow
# - OIDC for cloud credentials (no long-lived keys)
#
# The JWT_SECRET should be a cryptographically random 256-bit key.
# Rotate it periodically; on rotation, existing JWTs will be invalidated
# (acceptable since they're short-lived, 60 minutes).
# ---
